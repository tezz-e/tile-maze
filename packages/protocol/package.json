{
  "name": "@tiltmaze/protocol",
  "version": "1.0.0",
  "type": "module",
  "description": "Shared 20-byte binary telemetry codec and JSON control plane protocol for Tiltmaze",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
